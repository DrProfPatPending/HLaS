# HLaS Backup System - Configuration Template
#
# Copy this file and customize for your deployment:
#   cp .env.backup.example .env.backup
#
# Then include it in your docker-compose or backend services:
#   env_file:
#     - .env.prod
#     - .env.backup

# ============================================================================
# Backup Storage Configuration
# ============================================================================

# Local backup directory
# Default: /data/backups (inside container)
HLAS_BACKUP_DIR=/data/backups

# Enable backup system (true/false)
ENABLE_BACKUPS=true

# ============================================================================
# Automated Backup Schedule
# ============================================================================

# Backup interval in seconds
# 3600 = 1 hour, 86400 = 1 day (default), 604800 = 1 week
BACKUP_INTERVAL=86400

# Type of backup to run: full | database | filesystem
# full = database + filesystem (recommended)
# database = PostgreSQL only
# filesystem = files only
BACKUP_TYPE=full

# Directories to include in filesystem backup
# Comma-separated paths
BACKUP_DIRECTORIES=/data,/app/club_logos

# Automatic cleanup of old snapshots (days)
# Snapshots older than this will be deleted
BACKUP_CLEANUP_DAYS=30

# Maximum number of recent snapshots to keep
# If set, only keeps this many most recent backups
# Leave empty to disable
BACKUP_CLEANUP_MAX=10

# ============================================================================
# Cloud Storage Configuration (Optional)
# ============================================================================

# S3-compatible bucket name
# Leave empty to disable cloud uploads
# Examples:
#   - AWS S3: my-hlas-backups
#   - MinIO: backups
#   - DigitalOcean Spaces: my-space
BACKUP_CLOUD_BUCKET=

# AWS/S3 region
# Default: us-east-1
# Use 'auto' for DigitalOcean Spaces
BACKUP_CLOUD_REGION=us-east-1

# Cloud storage endpoint URL (for non-AWS services)
# Leave empty for AWS S3
# Examples:
#   - MinIO: https://minio.example.com:9000
#   - DigitalOcean Spaces: https://nyc3.digitaloceanspaces.com
#   - Wasabi: https://s3.us-west-1.wasabisys.com
BACKUP_CLOUD_ENDPOINT=

# AWS Access Key ID
# Required if BACKUP_CLOUD_BUCKET is set
# Can also use IAM instance roles (leave empty and configure instance role)
AWS_ACCESS_KEY_ID=

# AWS Secret Access Key
# Required if BACKUP_CLOUD_BUCKET is set
# Can also use IAM instance roles (leave empty and configure instance role)
AWS_SECRET_ACCESS_KEY=

# Cloud upload interval (seconds)
# Only used if backup-uploader service is enabled
# Default: 604800 (weekly), 0 = upload after every backup
BACKUP_UPLOAD_INTERVAL=604800

# ============================================================================
# Backup Verification & Monitoring
# ============================================================================

# Enable backup verification (check integrity after creation)
BACKUP_VERIFY=true

# Log level: DEBUG | INFO | WARNING | ERROR
BACKUP_LOG_LEVEL=INFO

# Email notifications on backup failure
# Leave empty to disable
BACKUP_NOTIFY_EMAIL=

# Alert if backup space usage exceeds this percentage (0-100)
BACKUP_ALERT_DISK_WARNING=80

# ============================================================================
# Database Connection (used for backup)
# ============================================================================

# PostgreSQL connection URL
# Format: postgresql://user:password@host:port/database
# Can also set POSTGRES_* variables below
DATABASE_URL=

# Or individual PostgreSQL settings:
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=hlas
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=hlas

# ============================================================================
# AWS/Cloud Service Credentials (Alternative format)
# ============================================================================

# Option 1: Access Keys (recommended for self-hosted)
# Use AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY above

# Option 2: IAM Instance Role (recommended for AWS EC2)
# Leave AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY empty
# Ensure your EC2 instance has an IAM role with s3:* permissions

# Option 3: AWS STS AssumeRole
# Leave empty if not needed
AWS_ROLE_ARN=
AWS_STS_EXTERNAL_ID=

# ============================================================================
# Retention & Policy
# ============================================================================

# Compression level: none | fast | balanced | maximum
# fast = good speed, good compression
# balanced = normal compression (default)
# maximum = slow but smaller files
BACKUP_COMPRESSION=balanced

# Encryption (future feature, currently unsupported)
# none | aes-256
BACKUP_ENCRYPTION=none

# Archive old backups to cheaper storage (future feature)
BACKUP_ARCHIVE_AFTER_DAYS=

# ============================================================================
# Example Configurations
# ============================================================================

# === LOCAL-ONLY BACKUP (SIMPLE) ===
# Just keep latest 10 full backups locally
# BACKUP_TYPE=full
# BACKUP_INTERVAL=86400
# BACKUP_CLEANUP_MAX=10
# BACKUP_CLOUD_BUCKET=

# === LOCAL + WEEKLY CLOUD (RECOMMENDED) ===
# Daily full backups locally, weekly upload to S3
# BACKUP_TYPE=full
# BACKUP_INTERVAL=86400
# BACKUP_CLEANUP_MAX=7
# BACKUP_CLOUD_BUCKET=my-hlas-backups
# BACKUP_UPLOAD_INTERVAL=604800

# === HOURLY DATABASE BACKUP ===
# Frequent database-only backups for high-availability
# BACKUP_TYPE=database
# BACKUP_INTERVAL=3600
# BACKUP_CLEANUP_DAYS=7

# === DEV/TEST (NO CLEANUP) ===
# Keep all backups, local only
# BACKUP_INTERVAL=0
# BACKUP_CLEANUP_MAX=

# === PRODUCTION MULTI-REGION ===
# Daily full backups, weekly uploads to multiple clouds
# (Use separate services/containers for each cloud target)
# BACKUP_TYPE=full
# BACKUP_INTERVAL=86400
# BACKUP_CLEANUP_DAYS=30
# BACKUP_CLEANUP_MAX=10

# ============================================================================
# Notes
# ============================================================================
#
# 1. DATABASE_URL format:
#    postgresql://username:password@host:port/database
#    Example: postgresql://hlas:mypass123@db.example.com:5432/hlas
#
# 2. For cloud storage:
#    - AWS S3: Set BACKUP_CLOUD_REGION and credentials
#    - MinIO: Set BACKUP_CLOUD_ENDPOINT to your MinIO URL
#    - DigitalOcean: Set BACKUP_CLOUD_ENDPOINT and use 'auto' region
#
# 3. Backup size estimation:
#    - Database: Typically 10-50% of disk usage
#    - Filesystem: Depends on photos/documents
#    - Compression: ~50-70% reduction (depending on file types)
#
# 4. AWS S3 cost estimation (us-east-1):
#    - Storage: $0.023 per GB per month
#    - Requests: ~$0.0007 per 10,000 requests
#    - Example: 50GB = ~$1.15/month
#
# 5. Restore procedures:
#    - Database: gunzip | psql -f
#    - Filesystem: tar -xzf
#    - See BACKUP_SYSTEM.md for detailed restore steps
#