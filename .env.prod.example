# Public DNS name pointing to your VPS
DOMAIN=your-domain.example.com

# Container image names (GHCR example)
BACKEND_IMAGE=ghcr.io/drprofpatpending/hlas-backend:latest
FRONTEND_IMAGE=ghcr.io/drprofpatpending/hlas-frontend:latest

# Optional
LOG_LEVEL=INFO

# Member auth token lifetimes (seconds)
HLAS_MEMBER_TOKEN_TTL_SECONDS=300
HLAS_MEMBER_REFRESH_TOKEN_TTL_SECONDS=600
