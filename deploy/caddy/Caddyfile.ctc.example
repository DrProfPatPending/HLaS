cambridgetroutclub.org {
	encode zstd gzip

	route {
		handle_path /api/* {
			reverse_proxy backend:5050
		}

		# The public site is not gated. To add a temporary pre-launch gate, add a
		# basic_auth block here (after the /api handler, before the other handlers).
		@root path /
		redir @root /club/CTC/ 302

		handle {
			reverse_proxy frontend:80
		}
	}
}

www.cambridgetroutclub.org {
	redir https://cambridgetroutclub.org{uri} 308
}

wordpress.cambridgetroutclub.org {
	encode zstd gzip

	# WordPress (content back end) is not a public site; keep it behind Basic Auth.
	# Generate the hash with: docker run --rm caddy:2 caddy hash-password
	# Replace the placeholders below in the real (untracked) Caddyfile.ctc.
	basic_auth bcrypt "Cambridge Trout Club: restricted" {
		CHANGE_ME_USERNAME CHANGE_ME_BCRYPT_HASH
	}

	reverse_proxy wordpress-web:80
}
