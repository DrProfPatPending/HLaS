hlastest {
	tls internal
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"

	handle /robots.txt {
		header Content-Type text/plain
		respond "User-agent: *\nDisallow: /\n" 200
	}

	handle_path /api/* {
		reverse_proxy ctc-dev-backend:5050
	}

	handle {
		reverse_proxy ctc-dev-frontend:80
	}
}

wordpress.hlastest {
	tls internal
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"

	handle /robots.txt {
		header Content-Type text/plain
		respond "User-agent: *\nDisallow: /\n" 200
	}

	handle {
		reverse_proxy wordpress-web:80
	}
}
