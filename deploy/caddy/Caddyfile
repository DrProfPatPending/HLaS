# Dev server Caddyfile — used on hlastest via docker-compose.dev.yml override.
# Uses Caddy's internal (local) CA so no ACME/Let's Encrypt challenges are needed.
# Run trust_caddy_mac.sh on your Mac to install the generated root CA into the
# macOS System Keychain so that Safari trusts the dev server.

hlastest {
	tls internal

	encode zstd gzip

	# Dev server must never be indexed by search engines.
	header X-Robots-Tag "noindex, nofollow"

	handle /robots.txt {
		header Content-Type text/plain
		respond <<TXT
			User-agent: *
			Disallow: /
			TXT 200
	}

	handle_path /api/* {
		reverse_proxy backend:5050
	}

	handle {
		reverse_proxy frontend:80
	}
}

wordpress.hlastest {
	tls internal

	encode zstd gzip

	header X-Robots-Tag "noindex, nofollow"

	handle /robots.txt {
		header Content-Type text/plain
		respond <<TXT
			User-agent: *
			Disallow: /
			TXT 200
	}

	reverse_proxy wordpress-web:80
}
