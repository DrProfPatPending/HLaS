# HLaS Backup Service - Systemd Edition
#
# Systemd service unit for running HLaS backups.
# More modern and reliable than cron for system services.
#
# Installation:
#   1. Place this file at: /etc/systemd/system/hlas-backup.service
#   2. Create companion timer: /etc/systemd/system/hlas-backup.timer
#   3. Enable and start:
#      $ sudo systemctl daemon-reload
#      $ sudo systemctl enable hlas-backup.timer
#      $ sudo systemctl start hlas-backup.timer
#
# Management:
#   $ sudo systemctl status hlas-backup.timer
#   $ sudo systemctl list-timers hlas-backup.timer
#   $ sudo journalctl -u hlas-backup -f
#
# Notes:
#   - Requires the companion .timer file to schedule execution
#   - Logs go to systemd journal (view with journalctl)
#   - Survives reboot automatically if enabled
#   - Better error handling and logging than cron

[Unit]
Description=HLaS Backup Service
Documentation=file:///opt/hlas/BACKUP_SYSTEM.md
After=network.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/hlas/backend

Environment="HLAS_BACKUP_DIR=/data/backups"
Environment="HLAS_LOG_LEVEL=INFO"

# Load the production environment if present, then construct a host-reachable
# DATABASE_URL for the Docker-published PostgreSQL port.
ExecStart=/bin/bash -lc 'if [ -f /opt/hlas/.env.prod ]; then set -a; source /opt/hlas/.env.prod; set +a; fi; export DATABASE_URL="postgresql://${POSTGRES_USER:-hlas}:${POSTGRES_PASSWORD:-hlas}@127.0.0.1:${POSTGRES_PORT:-5433}/${POSTGRES_DB:-hlas}"; exec /usr/bin/python3 /opt/hlas/backend/backup_cli.py create-full --description="Scheduled automated backup"'

# Cleanup old backups after the main snapshot finishes
ExecStartPost=/bin/bash -lc 'if [ -f /opt/hlas/.env.prod ]; then set -a; source /opt/hlas/.env.prod; set +a; fi; export DATABASE_URL="postgresql://${POSTGRES_USER:-hlas}:${POSTGRES_PASSWORD:-hlas}@127.0.0.1:${POSTGRES_PORT:-5433}/${POSTGRES_DB:-hlas}"; sleep 300; exec /usr/bin/python3 /opt/hlas/backend/backup_cli.py cleanup --days=30 --max=7'

# Restart policy
Restart=on-failure
RestartSec=60

# Security settings
NoNewPrivileges=true
PrivateTmp=true

# Resource limits - adjust as needed
CPUQuota=50%
MemoryLimit=1G
TasksMax=100

# Timeout - increase if backups are large
TimeoutStartSec=3600

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hlas-backup

[Install]
WantedBy=multi-user.target
