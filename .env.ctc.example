# Cambridge Trout Club (CTC) Production Configuration
# Copy this file to .env.ctc and customize as needed
# Copy all required database values from .env.prod, then set CTC-specific values.

# Database configuration (inherited from base .env.prod)
# Uncomment the following if you want to override:
# WORDPRESS_DB_HOST=localhost
# WORDPRESS_DB_NAME=wordpress
# WORDPRESS_DB_ROOT_PASSWORD=
# WORDPRESS_DB_USER=wordpress
# WORDPRESS_DB_PASSWORD=

# ============================================================================
# PUBLIC URL
# ============================================================================
# The build script mounts clubs.config.ctc.json with --clubs-config; do not set
# HLAS_CLUBS_CONFIG_PATH to a host path because that path is not visible inside
# the backend container.
WORDPRESS_PUBLIC_URL=https://wordpress.cambridgetroutclub.org

# ============================================================================
# Other optional environment variables
# ============================================================================
# Uncomment to customize as needed:

# LOG_LEVEL=INFO
# HLAS_USE_POSTGRES_READS=1
