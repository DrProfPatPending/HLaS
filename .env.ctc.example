# Cambridge Trout Club (CTC) Production Configuration
# Copy this file to .env.ctc and customize as needed
# This file demonstrates using an external clubs config for CTC-only deployment

# Database configuration (inherited from base .env.prod)
# Uncomment the following if you want to override:
# WORDPRESS_DB_HOST=localhost
# WORDPRESS_DB_NAME=wordpress
# WORDPRESS_DB_ROOT_PASSWORD=
# WORDPRESS_DB_USER=wordpress
# WORDPRESS_DB_PASSWORD=

# ============================================================================
# CLUBS CONFIG PATH
# ============================================================================
# Point to an external clubs.config.json containing only CTC configuration.
# This allows ctc-production branch to remain mergeable from development
# (which contains multi-club config) without conflicts.
#
# Options:
# 1. Volume mount approach (recommended):
#    Create /opt/hlas/clubs.config.ctc.json with CTC-only config
#    Set: HLAS_CLUBS_CONFIG_PATH=/opt/hlas/clubs.config.ctc.json
#
# 2. Git-tracked approach:
#    Commit backend/clubs.config.ctc.json to ctc-production branch
#    Set: HLAS_CLUBS_CONFIG_PATH=/opt/hlas/backend/clubs.config.ctc.json
#
HLAS_CLUBS_CONFIG_PATH=/opt/hlas/clubs.config.ctc.json

# ============================================================================
# Other optional environment variables
# ============================================================================
# Uncomment to customize as needed:

# LOG_LEVEL=INFO
# HLAS_DATA_DIR=/opt/hlas/backend
# HLAS_USE_POSTGRES_READS=1
