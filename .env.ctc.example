# Cambridge Trout Club (CTC) Production Configuration
# Copy this file to .env.ctc (which is gitignored) and replace every CHANGE_ME value.
# Never commit real passwords; .env.ctc must stay untracked.

# ============================================================================
# Images and domain
# ============================================================================
BACKEND_IMAGE=hlas-backend:latest
FRONTEND_IMAGE=hlas-frontend:latest
DOMAIN=cambridgetroutclub.org

# ============================================================================
# Application database (Postgres)
# ============================================================================
POSTGRES_USER=hlas
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=hlas
# Must use the same user, password and database as above.
DATABASE_URL=postgresql+psycopg://hlas:CHANGE_ME@postgres:5432/hlas
HLAS_USE_POSTGRES_READS=true
HLAS_USE_POSTGRES_WRITES=true
LOG_LEVEL=INFO

# SMTP password used for outgoing club email
GAAFFS_SMTP_PASSWORD=CHANGE_ME

# ============================================================================
# WordPress database
# ============================================================================
WORDPRESS_DB_HOST=wordpress-db
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_ROOT_PASSWORD=CHANGE_ME
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=CHANGE_ME

# ============================================================================
# PUBLIC URL
# ============================================================================
# The build script mounts clubs.config.ctc.json with --clubs-config; do not set
# HLAS_CLUBS_CONFIG_PATH to a host path because that path is not visible inside
# the backend container.
WORDPRESS_PUBLIC_URL=https://wordpress.cambridgetroutclub.org
